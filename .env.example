# Sonatola Upazila Digital Platform — example env (placeholders only, never commit real secrets)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.gov.bd
APP_KEY=change-me-32-chars-min

# Database (MySQL/MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sonatola
DB_USER=sonatola_user
DB_PASS=change-me
DB_CHARSET=utf8mb4

# Sessions / cookies
SESSION_NAME=sonatola_sid
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
# Server-side session expiry (minutes/hours). Idle slides on each request.
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Password reset (disabled by default — requires SMTP + settings flag).
# Both must be true/1 to issue tokens; otherwise requests are logged and ignored.
# See docs/api-v1.md "Password reset" for SMTP delivery requirements.
# Never log or expose raw reset tokens.
PASSWORD_RESET_ENABLED=false

# CORS (comma separated origins, empty = same-origin only)
CORS_ALLOWED_ORIGINS=

# Uploads
UPLOAD_MAX_MB=5
UPLOAD_DIR=../storage/uploads

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
API_RATE_PER_MINUTE=60

# First admin bootstrap is via CLI only (scripts/create_admin.php), no seeded admin.
